<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="AvaloniaBaseTemplate.MainWindow"
        Icon="/assets/app.ico"
        Title="Avalonia UI Base Template">

	<StackPanel VerticalAlignment="Center">
		<TextBlock HorizontalAlignment="Center" Margin="0,20,0,20" FontSize="36" FontWeight="Bold">
			Hello!
		</TextBlock>
		<TextBlock HorizontalAlignment="Center" Margin="0,20,0,20" FontSize="24" >
			This is a simple template project for Avalonia UI desktop apps.
		</TextBlock>
		<TextBlock HorizontalAlignment="Center" Margin="0,20,0,20" FontSize="24">
			Feel free to modify it as you need.
		</TextBlock>
	</StackPanel>
</Window>
